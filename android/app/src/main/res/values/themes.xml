<?xml version="1.0" encoding="utf-8"?>
<!-- 应用主题: 不用 ActionBar(自己画头部), 状态栏/导航栏跟随背景色 -->
<resources>
    <style name="Theme.EasyMath" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.EasyMath.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.EasyMath.Dialog</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarFadeDuration">0</item>
    </style>

    <!-- 1.63.6: 对话框也必须有非 null 的滚动条 drawable, 否则 Android 16 上
         View.onDrawScrollBars 会在对话框内的 ScrollView 上抛 NPE。 -->
    <style name="Theme.EasyMath.Dialog" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarTrackVertical">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarTrackHorizontal">@drawable/scrollbar_transparent</item>
        <item name="android:scrollbarFadeDuration">0</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
